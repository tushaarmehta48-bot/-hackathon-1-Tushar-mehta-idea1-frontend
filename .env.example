# NestJS API (versioned prefix is included in the base URL)
# Local: http://localhost:3001/api/v1
# Render: https://hackathon-1-tushar-mehta-idea1-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=
# Display timezone for dates/times (IANA name; confirm with venue owner)
NEXT_PUBLIC_RESTAURANT_TIMEZONE=

# Supabase — only the anon key is safe in the browser bundle
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
