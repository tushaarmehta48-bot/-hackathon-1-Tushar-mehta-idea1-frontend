# NestJS API (versioned prefix is included in the base URL)
NEXT_PUBLIC_API_URL=
# Display timezone for dates/times (IANA name; confirm with venue owner)
NEXT_PUBLIC_RESTAURANT_TIMEZONE=

# Supabase — only the anon key is safe in the browser bundle
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Customer OAuth (Supabase Dashboard → Authentication → Providers)
# Redirect URL to allow: https://your-site.com/auth/callback (and http://localhost:3000/auth/callback)
# Optional: set to google to show Google sign-in (default when unset)
# NEXT_PUBLIC_OAUTH_PROVIDERS=google
